{
  "name": "@pittica/google-business-intelligence-helpers",
  "private": false,
  "version": "1.15.3",
  "description": "Helpers for business intelligence for Google Cloud.",
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf ./dist && mkdirp ./dist && babel src --out-dir dist --copy-files",
    "test": "echo \"Error: no test specified\" && exit 1",
    "unlistened": "npm run build && run-func ./dist/scripts/unlistened.js scriptUnlistened",
    "comparison": "npm run build && run-func ./dist/scripts/comparison.js scriptComparison",
    "download-schema": "npm run build && run-func ./dist/scripts/schema.js scriptDownloadSchemas",
    "implode": "npm run build && run-func ./dist/scripts/storage.js scriptImplode",
    "erase": "npm run build && run-func ./dist/scripts/storage.js scriptErase",
    "backup": "npm run build && run-func ./dist/scripts/backup.js scriptBackup",
    "backup-erase": "npm run build && run-func ./dist/scripts/backup.js scriptBackupErase",
    "rollback": "npm run build && run-func ./dist/scripts/backup.js scriptRollback"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pittica/google-business-intelligence-helpers.git"
  },
  "keywords": [
    "pittica",
    "business-intelligence",
    "google-cloud-platform",
    "gcp"
  ],
  "author": "Lucio Benini <lucio.benini@pittica.com>",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/pittica/google-business-intelligence-helpers/issues"
  },
  "homepage": "https://github.com/pittica/google-business-intelligence-helpers",
  "engines": {
    "node": ">=24.11.0"
  },
  "dependencies": {
    "@pittica/google-bigquery-helpers": "^1.7.0",
    "@pittica/google-cloud-storage-helpers": "^1.6.0",
    "@pittica/logger-helpers": "^1.2.2",
    "date-and-time": "^4.7.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "mkdirp": "^3.0.1",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "run-func": "^3.0.0"
  }
}
